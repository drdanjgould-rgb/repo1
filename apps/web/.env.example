# Copy to apps/web/.env.local and fill in values.
# Both values MUST match what `apps/api/.env.local` uses.

# Where the Hono API is reachable from the Next.js server.
CONSOLE_API_BASE_URL=http://localhost:3000

# Bearer token gating all /api/v1/* console routes. Must equal
# STAFF_API_TOKEN in apps/api/.env.local. Treat as a secret.
STAFF_API_TOKEN=replace-me-with-a-long-random-string
